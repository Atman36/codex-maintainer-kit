{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/prfactory/PRSpec.schema.json",
  "title": "PRSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "repo",
    "base",
    "head",
    "title",
    "body_markdown",
    "change_type",
    "risk",
    "files_touched",
    "test_plan",
    "ai_assistance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "owner",
        "name",
        "default_branch"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "minLength": 7
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "body_markdown": {
      "type": "string",
      "minLength": 20
    },
    "change_type": {
      "type": "string",
      "enum": [
        "docs",
        "test",
        "bugfix",
        "refactor",
        "perf",
        "security",
        "dx",
        "build",
        "ci",
        "chore"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "breaking_change": {
      "type": "boolean",
      "default": false
    },
    "files_touched": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maintainer_notes": {
      "type": "string"
    },
    "ai_assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "tools",
        "disclosure_line"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "disclosure_line": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      }
    },
    "merge_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability",
        "reasons",
        "blockers"
      ],
      "properties": {
        "probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}